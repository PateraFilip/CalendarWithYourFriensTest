# Lokální secrets pro migraci Paříž → Frankfurt (NECOMMITOVAT)
# Zkopíruj jako .env.migration a doplň hodnoty.

SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
OLD_DB_PASSWORD=paris_database_password
NEW_DB_PASSWORD=frankfurt_database_password

# Org + starý projekt (výchozí hodnoty v skriptu)
ORG_ID=sdjsrtvuqhsjlsznmdop
OLD_PROJECT_REF=sdzyhihtqrgsntbxlugp
NEW_PROJECT_NAME=calendarWithFriends-fra

# Po vytvoření Frankfurt projektu (nebo pokud už existuje):
# NEW_PROJECT_REF=

# Volitelně pooler URL, pokud Direct connection (IPv6) nefunguje:
# OLD_DB_URL=postgresql://postgres.sdzyhihtqrgsntbxlugp:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# NEW_DB_URL=postgresql://postgres.NEWREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Pro copy-storage-bucket.mjs a deploy:
# OLD_SUPABASE_SERVICE_ROLE_KEY=
# NEW_SUPABASE_URL=https://NEWREF.supabase.co
# NEW_SUPABASE_SERVICE_ROLE_KEY=
